#!/usr/bin/env bash
# Install Firefox from Mozilla's APT repository
# https://support.mozilla.org/en-US/kb/install-firefox-linux#w_install-firefox-deb-package-for-debian-based-distributions

set -euo pipefail

KEYRING=/etc/apt/keyrings/packages.mozilla.org.asc
SOURCES=/etc/apt/sources.list.d/mozilla.sources
PREFERENCES=/etc/apt/preferences.d/mozilla
FINGERPRINT=35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3

if [[ ! -f "$KEYRING" ]]; then
  sudo install -d -m 0755 /etc/apt/keyrings
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' EXIT
  curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg -o "$tmp"
  if ! gpg -n -q --import --import-options import-show "$tmp" | grep -q "$FINGERPRINT"; then
    echo "Mozilla signing key fingerprint mismatch" >&2
    exit 1
  fi
  sudo install -m 0644 "$tmp" "$KEYRING"
fi

if [[ ! -f "$SOURCES" ]]; then
  sudo tee "$SOURCES" > /dev/null <<EOF
Types: deb
URIs: https://packages.mozilla.org/apt
Suites: mozilla
Components: main
Signed-By: $KEYRING
EOF
fi

# Prefer Mozilla's package over the distro (snap transitional) package
if [[ ! -f "$PREFERENCES" ]]; then
  sudo tee "$PREFERENCES" > /dev/null <<EOF
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000
EOF
fi

# Ubuntu ships a "firefox" deb that only installs the snap; treat that as not present
version=$(dpkg-query -W -f='${Status} ${Version}' firefox 2>/dev/null || true)
if [[ "$version" != "install ok installed"* || "$version" == *snap* ]]; then
  sudo apt-get update
  sudo apt-get install -y firefox
fi
