#!/usr/bin/env bash
set -euo pipefail

version=$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
  https://github.com/tree-sitter/tree-sitter/releases/latest)
version=${version##*/}   # e.g. v0.26.9
target_dir="$HOME/.local/bin"
bin="$target_dir/tree-sitter"

if [ -x "$bin" ]; then
  installed=$("$bin" --version | awk '{print $2}')
  if [ "$installed" = "${version#v}" ]; then
    echo "tree-sitter $installed is already the latest, nothing to do"
    exit 0
  fi
fi

echo "Installing tree-sitter $version"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl -fL "https://github.com/tree-sitter/tree-sitter/releases/download/$version/tree-sitter-cli-linux-x64.zip" \
  -o "$tmp/tree-sitter.zip"
mkdir -p "$target_dir"
unzip -o "$tmp/tree-sitter.zip" tree-sitter -d "$target_dir"
chmod +x "$bin"
