#!/usr/bin/env bash
set -euo pipefail


packages=(
    curl
  )

missing_packages=()

for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "install ok installed"; then
    missing_packages+=("$package")
  fi
done

if ((${#missing_packages[@]} > 0)); then
  sudo apt-get update
  sudo apt-get install -y "${missing_packages[@]}"
fi

VERSION=$(curl -sI https://github.com/junegunn/fzf/releases/latest | grep -i "^location:" | sed -E "s|.*/tag/v([^[:space:]]+).*|\1|")

curl "https://github.com/junegunn/fzf/releases/download/v$VERSION/fzf-$VERSION-linux_amd64.tar.gz" -o fzf-$VERSION-linux_amd64.tar.gz \
    && tar zxvf fzf-$VERSION-linux_amd64.tar.gz -C ~/.local/bin/ fzf \
    && rm fzf-$VERSION-linux_amd64.tar.gz
