#!/usr/bin/env bash
set -euo pipefail


packages=(
    curl
  )

missing_packages=()

for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q "install ok installed"; then
    missing_packages+=("$package")
  fi
done

if ((${#missing_packages[@]} > 0)); then
  sudo apt-get update
  sudo apt-get install -y "${missing_packages[@]}"
fi

# https://go.dev/dl/
VERSION=$(curl -fsSL "https://go.dev/VERSION?m=text" | head -n1)

curl -fL "https://go.dev/dl/$VERSION.linux-amd64.tar.gz" -o "$VERSION.linux-amd64.tar.gz"
mkdir -p ~/.local/opt ~/.local/bin
rm -rf ~/.local/opt/go && tar -C ~/.local/opt -xzf "$VERSION.linux-amd64.tar.gz" && rm "$VERSION.linux-amd64.tar.gz"
ln -fs ~/.local/opt/go/bin/go ~/.local/bin
ln -fs ~/.local/opt/go/bin/gofmt ~/.local/bin
