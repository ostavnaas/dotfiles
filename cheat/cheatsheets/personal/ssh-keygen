# FIDO2 support
# Requirements: OpenSSH 8.2+ and libfido2. On Debian/Ubuntu run sudo apt install libfido2-1.
# - -O resident stores the key handle on the YubiKey.
# - -O verify-required asks for the PIN as well as a touch.
ssh-keygen -t ed25519-sk -O resident -O verify-required -C "commend" -f ~/.ssh/id_ed25519_sk
# Create public key from private key
ssh-keygen -f ~/.ssh/id_rsa -y > ~/.ssh/id_rsa.pub

# Convert public-key to PEM
ssh-keygen  -f ~/.ssh/id_rsa -e -m PEM

# Convert Private-key to PEM format
ssh-keygen -p -f ~/.ssh/id_rsa -m PEM

# Verify private<->public key paris
ssh-keygen -l -E md5 -f ~/.ssh/id_rsa(.pub)

# Generate keys
ssh-keygen -t rsa -b 4096
ssh-keygen -t dsa
ssh-keygen -t ecdsa -b 521
ssh-keygen -t ed25519


# Private key
-m PKCS8
-----BEGIN PRIVATE KEY-----
or
-----BEGIN ENCRYPTED PRIVATE KEY-----

-m RFC4716
-----BEGIN OPENSSH PRIVATE KEY-----

# Public keys
-m PKCS8
-----BEGIN PUBLIC KEY-----
-m PEM
-----BEGIN RSA PUBLIC KEY-----
-m RFC4716
---- BEGIN SSH2 PUBLIC KEY ----
