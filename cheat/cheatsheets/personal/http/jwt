# ============================================================================
#  6. HS256 (shared secret) by hand
# ============================================================================
$ b64url() { base64 -w0 | tr '+/' '-_' | tr -d '='; }
$ H=$(printf '%s' '{"alg":"HS256","typ":"JWT"}' | b64url)
$ P=$(printf '%s' '{"sub":"user-123","exp":1760950800}' | b64url)
$ S=$(printf '%s' "$H.$P" | openssl dgst -sha256 -hmac 'secret' -binary | b64url)
$ echo "$H.$P.$S"
