# ============================================================================
#  2. Decode (no verification)
# ============================================================================
# header + payload with jq
$ jq -R 'split(".") | .[0:2] | map(gsub("-";"+") | gsub("_";"/") | @base64d | fromjson)' <<< "$TOKEN"

# payload only, plain shell (ignore the padding warning)
$ cut -d. -f2 <<< "$TOKEN" | tr '_-' '/+' | base64 -d 2>/dev/null | jq .

# exp as a date
$ date -d @1760950800 -u


