# --- RSA key fields (RS256 / PS256) -----------------------------------------
#   "kty": "RSA", "n": "<modulus, base64url>", "e": "AQAB"   (e = 65537)

# --- pick the key for a token -----------------------------------------------
$ KID=$(jq -rR 'split(".")[0] | gsub("-";"+") | gsub("_";"/") | @base64d | fromjson | .kid' <<< "$TOKEN")
$ jq --arg kid "$KID" '.keys[] | select(.kid == $kid)' jwks.json

# --- JWK thumbprint (RFC 7638), often used as kid ---------------------------
# sha256 over the required members only, sorted, no whitespace
$ jq -cj '.keys[0] | {crv,kty,x,y}' jwks.json | openssl dgst -sha256 -binary | base64 -w0 | tr '+/' '-_' | tr -d '='
