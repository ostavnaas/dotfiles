# POST - https://datatracker.ietf.org/doc/html/rfc9110#section-9.3.3
# https://developer.mozilla.org/en-US/docs/Web/HTTP/Methods/POST
#
# Note: -d / -F / --json already imply POST, no need for -X POST
# Note: quote URLs containing ? or & (zsh globbing / shell backgrounding)
#
# Request layout - https://datatracker.ietf.org/doc/html/rfc9112#section-2.1
#   request-line   METHOD SP request-target SP HTTP-version CRLF
#   header fields  Name: value CRLF  (one per line)
#   empty line     CRLF  (ends the headers)
#   body           Content-Length bytes, or chunked


# ============================================================================
#  1. application/x-www-form-urlencoded
# ============================================================================
# python: httpx.post('http://www.example.com/test', data={'field1': 'value1', 'field2': 'value2'})
$ curl -d 'field1=value1&field2=value2' http://www.example.com/test

> POST /test HTTP/1.1                                          # request-line: method, path, version
> Host: www.example.com                                        # header: target host (required in HTTP/1.1)
> User-Agent: curl/8.18.0                                      # header: client name/version
> Accept: */*                                                  # header: response types we accept
> Content-Length: 27                                           # header: body size in bytes
> Content-Type: application/x-www-form-urlencoded              # header: body format
>                                                              # empty line (CRLF) ends the headers
field1=value1&field2=value2                                    # body: key=value pairs joined with &

# --- variant: send a file as the body ---------------------------------------
# --data-binary keeps the file unchanged (-d @file strips newlines)
# Content-Type is still application/x-www-form-urlencoded unless set with -H
$ curl --data-binary @file.txt -H 'Content-Type: text/plain' http://www.example.com/files


# ============================================================================
#  2. Transfer-Encoding: chunked
#     https://datatracker.ietf.org/doc/html/rfc9112#section-7.1
# ============================================================================
# Used when the body size is not known up front: no Content-Length, the body
# is sent as <size in hex> CRLF <data> CRLF ... and ends with a 0-size chunk.
#
# python: httpx sends chunked when the body is an iterator
#         httpx.post('http://www.example.com/file', content=iter([b'one-byte']))
$ curl -H 'Transfer-Encoding: chunked' --data-raw 'one-byte' http://www.example.com/file

> POST /file HTTP/1.1                                          # request-line
> Host: www.example.com                                        # header
> User-Agent: curl/8.18.0                                      # header
> Accept: */*                                                  # header
> Transfer-Encoding: chunked                                   # header: body is chunked (replaces Content-Length)
> Content-Type: application/x-www-form-urlencoded              # header: added by curl because of -d/--data-raw
>                                                              # empty line ends the headers
8                                                              # chunk size in hex (8 bytes)
one-byte                                                       # chunk data
0                                                              # last chunk (size 0)
                                                               # empty line ends the body

# --- raw body on the wire ---------------------------------------------------
# ASCII:  8\r\none-byte\r\n0\r\n\r\n
#
# hex:    38 0d 0a 6f 6e 65 2d 62 79 74 65 0d 0a 30 0d 0a 0d 0a
#         8  CR LF o  n  e  -  b  y  t  e  CR LF 0  CR LF CR LF
#         |  |___| |______________________| |___| |  |___| |___|
#         |  end   chunk data               end   |  end   end of body
#         size     of size line             data  last chunk


# ============================================================================
#  3. multipart/form-data (file upload)
#     https://datatracker.ietf.org/doc/html/rfc7578
# ============================================================================
# python: httpx.post('http://www.example.com/files', files={'upload-file': ('Dockerfile', open('Dockerfile', 'rb'))})
$ curl -F 'upload-file=@Dockerfile' http://www.example.com/files

> POST /files HTTP/1.1                                         # request-line
> Host: www.example.com                                        # header
> User-Agent: curl/8.18.0                                      # header
> Accept: */*                                                  # header
> Content-Length: 378                                          # header: whole body incl. boundaries
> Content-Type: multipart/form-data; boundary=------------------------yjciPZIK1q94rTTZdztB7E
>                                                              # ^ header: boundary separates the parts
--------------------------yjciPZIK1q94rTTZdztB7E               # part start: "--" + boundary
Content-Disposition: form-data; name="upload-file"; filename="Dockerfile"  # part header: field name + filename
Content-Type: application/octet-stream                         # part header: file type
                                                               # empty line ends the part headers
FROM python                                                    # part body: file content ...

ENV PIPENV_VENV_IN_PROJECT=1
WORKDIR /src
COPY Pipfile Pipfile.lock /src/
RUN pip install pipenv && pipenv sync
ENV PATH="/src/.venv/bin:$PATH"                                # ... end of file content

--------------------------yjciPZIK1q94rTTZdztB7E--             # end: "--" + boundary + "--"


# ============================================================================
#  4. application/json
# ============================================================================
# python: httpx.post('https://www.example.com/path', params={'query': 'value'}, json={'payload': 'value'}, headers={'Header': 'value'})
$ curl -H 'Header: value' -H 'Content-Type: application/json' -d '{"payload": "value"}' 'https://www.example.com/path?query=value'

> POST /path?query=value HTTP/1.1                              # request-line: path + query string
> Host: www.example.com                                        # header
> User-Agent: curl/8.18.0                                      # header
> Accept: */*                                                  # header
> Header: value                                                # header: custom, from -H
> Content-Type: application/json                               # header: body format, from -H
> Content-Length: 20                                           # header: body size in bytes
>                                                              # empty line ends the headers
{"payload": "value"}                                           # body: JSON

# --- variant: curl >= 7.82 --------------------------------------------------
# --json sets Content-Type and Accept to application/json
$ curl -H 'Header: value' --json '{"payload": "value"}' 'https://www.example.com/path?query=value'
