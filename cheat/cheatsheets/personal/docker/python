ARG UV_VERSION=0.13.5
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac AS python-base
ARG PYTHON_VERSION=3.14.9
COPY --from=uv /uv /uvx /bin/

ENV UV_PYTHON_INSTALL_DIR=/usr/local/lib/
ENV UV_PYTHON=/usr/local/bin/python3
RUN uv python install ${PYTHON_VERSION} \
    && UV_PYTHON_PATH="$(uv python find --managed-python ${PYTHON_VERSION})" \
    && ln -sf "$UV_PYTHON_PATH" "/usr/local/bin/python${PYTHON_VERSION%.*}" \
    && ln -s "$UV_PYTHON_PATH" /usr/local/bin/python3 \
    && test "$(python3 -c 'import platform; print(platform.python_version())')" = "${PYTHON_VERSION}"
