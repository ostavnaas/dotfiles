list []

┌─────────────────────────────────────────────┬────────────────┐
│                  Operation                  │    Average     │
├─────────────────────────────────────────────┼────────────────┤
│ len(l)                                      │ O(1)           │
├─────────────────────────────────────────────┼────────────────┤
│ l[i], l[i] = x                              │ O(1)           │
├─────────────────────────────────────────────┼────────────────┤
│ l.append(x)                                 │ O(1) amortized │
├─────────────────────────────────────────────┼────────────────┤
│ l.pop()                                     │ O(1)           │
├─────────────────────────────────────────────┼────────────────┤
│ l.pop(i), l.insert(i, x)                    │ O(n − i)       │
├─────────────────────────────────────────────┼────────────────┤
│ del l[i]                                    │ O(n − i)       │
├─────────────────────────────────────────────┼────────────────┤
│ x in l, l.index(x), l.count(x), l.remove(x) │ O(n)           │
├─────────────────────────────────────────────┼────────────────┤
