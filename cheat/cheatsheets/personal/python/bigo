│ del l[a:b]                                  │ O(n)           │
├─────────────────────────────────────────────┼────────────────┤
│ l.extend(it), l += it                       │ O(k) amortized │
├─────────────────────────────────────────────┼────────────────┤
│ l + l2                                      │ O(n + k)       │
├─────────────────────────────────────────────┼────────────────┤
│ l * m                                       │ O(n·m)         │
├─────────────────────────────────────────────┼────────────────┤
│ l.copy(), list(l)                           │ O(n)           │
├─────────────────────────────────────────────┼────────────────┤
│ l.reverse()                                 │ O(n)           │
├─────────────────────────────────────────────┼────────────────┤
│ l.sort(), sorted(l)                         │ O(n log n)     │
├─────────────────────────────────────────────┼────────────────┤
│ min, max, sum                               │ O(n)           │
├─────────────────────────────────────────────┼────────────────┤
